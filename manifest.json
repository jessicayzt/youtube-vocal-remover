{
  "manifest_version": 3,
  "name": "YouTube Vocal Remover",
  "version": "0.1.0",
  "description": "Removes vocals from YouTube videos.",
  "minimum_chrome_version": "124",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YouTube Vocal Remover",
    "default_popup": "popup.html"
  },
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": [
        "src/content/hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": [
        "src/shared/ranges.js",
        "src/shared/gate.js",
        "src/shared/base64.js",
        "src/content/ui.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/ui.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
